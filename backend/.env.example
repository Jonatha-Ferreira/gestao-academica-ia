# ---------------------------------------------------------------------------
# Provedor de LLM do assistente acadêmico.
# Valores aceitos: anthropic | openai | demo
# Se não for definido, o sistema escolhe automaticamente:
#   anthropic (se ANTHROPIC_API_KEY) > openai (se OPENAI_API_KEY) > demo
# Sem nenhuma chave, roda em modo demonstrativo (respostas locais).
# ---------------------------------------------------------------------------
LLM_PROVIDER=demo

# --- Anthropic (Claude) ---
# NUNCA versione este arquivo .env, apenas o .env.example.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Servidor HTTP ---
PORT=3333

# Origem permitida para CORS (front-end em desenvolvimento).
CORS_ORIGIN=http://localhost:5173

# --- Integração de IA em tempo de execução (painel "Integrar IA") ---
# Senha que protege a configuração da IA exposta em /api/ia/*.
# Troque obrigatoriamente em ambientes reais.
IA_ADMIN_PASSWORD=troque-esta-senha
